rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 資料只放在 families/{家庭編號}/ 底下。家庭編號是「家庭暗號」的雜湊值（64 個十六進位字元）。
    // 沒有開放列出 families 底下的所有家庭，只有知道完整家庭編號的人才讀得到。
    match /families/{fid}/{document=**} {
      allow read, write: if request.auth != null && fid.matches('^[0-9a-f]{64}$');
    }
  }
}
