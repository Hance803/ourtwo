{
  "name": "ourtwo-push",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STATE",
        "class_name": "State"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "State"
      ]
    }
  ]
}